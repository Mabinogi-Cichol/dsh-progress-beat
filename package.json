{
  "name": "dsh-progress-beat",
  "version": "0.1.0",
  "description": "让 DSH 在长工具链执行中途输出可见进度说明（system prompt 规则 + 步骤级注入提醒）",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "cordis",
    "progress",
    "narration"
  ],
  "license": "MIT",
  "author": "Mabinogi-Cichol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mabinogi-Cichol/dsh-progress-beat.git"
  },
  "homepage": "https://github.com/Mabinogi-Cichol/dsh-progress-beat#readme",
  "bugs": {
    "url": "https://github.com/Mabinogi-Cichol/dsh-progress-beat/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19"
  }
}
